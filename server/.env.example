# ===== 基础 =====
# 后端监听端口（仅内部使用；对外由 1Panel/OpenResty 反代）
PORT=3000

# 会话签名密钥，生产环境必须改成足够长的随机字符串
SESSION_SECRET=change-me-to-a-long-random-string

# ===== Campux OAuth2 登录 =====
# Campux 站点根地址（不带路径、不带末尾斜杠）
CAMPUX_BASE_URL=https://campux.example.com
# Campux 后台创建应用后复制的凭据
CAMPUX_CLIENT_ID=your-client-id
CAMPUX_CLIENT_SECRET=your-client-secret
# 回调地址，必须与 Campux 后台 redirectUris 逐字符一致
CAMPUX_REDIRECT_URI=http://localhost:3000/api/auth/callback
# 登录成功后跳回的前端地址
FRONTEND_URL=http://localhost:5173

# ===== 上传与 Cookie =====
# 图片上传目录（相对 server 目录或绝对路径；生产建议放部署目录之外并持久化）
UPLOAD_DIR=./uploads
# 仅 HTTPS 部署时设为 true，纯 HTTP 不要设置
# COOKIE_SECURE=true

# ===== QQ 空间发布（可选覆盖，一般无需配置） =====
# QZone 接口端点。默认使用官方地址；仅本地联调接 mock 时才需要覆盖
# QZONE_PUBLISH_ENDPOINT=https://user.qzone.qq.com/proxy/domain/taotao.qzone.qq.com/cgi-bin/emotion_cgi_publish_v6
# QZONE_UPLOAD_ENDPOINT=https://up.qzone.qq.com/cgi-bin/upload/cgi_upload_image
